          "type": "tool_use",
          "name": "Write",
          "input": {
            "content": "import Foundation\n\n/// Unified transport-failure classification shared by catalog, thumbnail, HD preview,\n/// download, and background metadata pipelines.\n///\n/// The contract: every `catch` block that receives an `Error` from a PTP/network\n/// operation classifies it through `CameraTransportFailureDispositionPolicy.disposition(for:)`\n/// and acts on the result:\n///\n/// - `.sessionTerminal`: stop the pump/loop, invoke the session-level failure reporter once, return.\n/// - `.retryableOperation`: use the existing bounded retry policy (handle-local budget).\n/// - `.contentFailure`: mark the item as failed, continue to the next.\n/// - `.cancelled`: do not publish failure UI, do not report session failure.\nenum CameraTransportFailureDisposition: Equatable {\n  case cancelled\n  case retryableOperation\n  case sessionTerminal\n  case contentFailure\n}\n\nenum CameraTransportFailureDispositionPolicy {\n  /// Classify an error thrown by a PTP/network operation.\n  ///\n  /// Classification priority:\n  /// 1. CancellationError → `.cancelled`\n  /// 2. CameraVendorPtpSocket domain → `.sessionTerminal` (socket-level = connection dead)\n  /// 3. NSPOSIXErrorDomain → `.sessionTerminal` (low-level I/O failure)\n  /// 4. NSURLErrorDomain connection-class codes → `.sessionTerminal`\n  /// 5. Known message patterns (fallback) → `.sessionTerminal`\n  /// 6. CameraVendorPtpSession domain → `.retryableOperation` (command-level, PTP lane may survive)\n  /// 7. Everything else → `.contentFailure`\n  static func disposition(for error: Error) -> CameraTransportFailureDisposition {\n    if error is CancellationError {\n      return .cancelled\n    }\n\n    let nsError = error as NSError\n\n    // Socket-level: the physical connection is dead.\n    if nsError.domain == \"CameraVendorPtpSocket\" {\n      return .sessionTerminal\n    }\n\n    // POSIX I/O errors: broken pipe, connection reset, etc.\n    if nsError.domain == NSPOSIXErrorDomain {\n      return .sessionTerminal\n    }\n\n    // URL connection failures that prove network path loss.\n    if nsError.domain == NSURLErrorDomain {\n      switch nsError.code {\n      case NSURLErrorCannotConnectToHost,\n           NSURLErrorNetworkConnectionLost,\n           NSURLErrorNotConnectedToInternet,\n           NSURLErrorTimedOut:\n        return .sessionTerminal\n      default:\n        break\n      }\n    }\n\n    // Message-based fallback for errors wrapped without structured domain/code.\n    if messageProvesTransportLoss(nsError) {\n      return .sessionTerminal\n    }\n\n    // PTP session-level responses: the socket is alive but the command failed.\n    // These are retryable (e.g. store-not-available 0x2013, busy 0x2019).\n    if nsError.domain == \"CameraVendorPtpSession\" {\n      return .retryableOperation\n    }\n\n    // Anything else (decode failure, unsupported format, etc.)\n    return .contentFailure\n  }\n\n  /// Returns true if the error chain contains messages that prove the transport is lost.\n  /// This is the compatibility fallback for errors that don't carry structured domain/code.\n  private static func messageProvesTransportLoss(_ nsError: NSError) -> Bool {\n    var current: NSError? = nsError\n    while let error = current {\n      let message = error.localizedDescription.lowercased()\n      if message.contains(\"socket 未建立\") ||\n          message.contains(\"connection reset\") ||\n          message.contains(\"broken pipe\") ||\n          message.contains(\"not connected to camera\") ||\n          message.contains(\"socket is closed\") {\n        return true\n      }\n      current = error.userInfo[NSUnderlyingErrorKey] as? NSError\n    }\n    return false\n  }\n}\n",
